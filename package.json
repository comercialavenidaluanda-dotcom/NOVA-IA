{
  "name": "nova-ai-studio",
  "version": "0.1.0",
  "private": true,
  "description": "NOVA AI STUDIO - editor multimédia e ambiente de desenvolvimento com IA",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=dist-server/index.cjs --external:express --external:cors --external:multer --external:ffmpeg-static && vite build",
    "start:api": "node dist-server/index.cjs",
    "desktop": "concurrently -k \"npm:dev:web\" \"npm:dev:api\" \"wait-on http://localhost:5173 && electron electron/main.cjs\"",
    "dist:win": "npm run build && electron-builder --win nsis",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1",
    "ffmpeg-static": "^5.2.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1",
    "esbuild": "^0.24.2",
    "@types/multer": "^2.0.0"
  },
  "build": {
    "appId": "ao.nova.aistudio",
    "productName": "NOVA AI STUDIO",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NOVA AI STUDIO"
    },
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg.exe"
      }
    ]
  }
}